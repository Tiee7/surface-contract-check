{
  "sources": {
    "sales": {
      "path": "pages/sales.html",
      "format": "html"
    },
    "docs": {
      "path": "pages/docs.html",
      "format": "html"
    }
  },
  "checks": [
    {
      "name": "starter monthly price",
      "rule": "equal",
      "extract": [
        {
          "source": "sales",
          "pattern": "Starter:\\s*\\$(\\d+)"
        },
        {
          "source": "docs",
          "pattern": "Starter:\\s*\\$(\\d+)"
        }
      ]
    }
  ]
}
